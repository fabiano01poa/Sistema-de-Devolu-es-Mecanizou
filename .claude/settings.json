{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(curl -X POST:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./sync_config.json)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./private/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*service-account*.json)",
      "Read(**/*credentials*.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./sync_config.json)",
      "Edit(./secrets/**)",
      "Edit(./credentials/**)",
      "Edit(./private/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
